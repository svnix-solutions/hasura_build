# Image tag. Pin it -- "latest" is not a version.
HASURA_VERSION=v2.50.3-ce

# Postgres holding Hasura's metadata. Hasura has no embedded storage, so this
# must be an existing, reachable Postgres. Point it at an instance that is
# already backed up and the metadata comes along for free.
HASURA_DB_HOST=10.0.0.5
HASURA_DB_PORT=5432
HASURA_DB_NAME=hasura
HASURA_DB_USER=hasura
HASURA_DB_PASSWORD=changeme

# REQUIRED. Without it the GraphQL API and console are unauthenticated and
# anyone who can reach the port has full admin rights over every tracked table.
HASURA_ADMIN_SECRET=changeme

# Console is protected by the admin secret above.
HASURA_ENABLE_CONSOLE=true

# Returns internal error details to clients. Leave false unless debugging on a
# network you fully control.
HASURA_DEV_MODE=false

# Address the port binds to. Defaults to 127.0.0.1 (loopback only).
HASURA_BIND=127.0.0.1
HASURA_PORT=8080

# Restrict this to your actual origins in production.
HASURA_CORS_DOMAIN=*

# Optional. Names the role given to requests carrying no auth.
# Leave it OUT entirely and unauthenticated requests are rejected outright.
# Hasura rejects an empty value, so comment the line rather than blanking it.
#HASURA_GRAPHQL_UNAUTHORIZED_ROLE=anonymous

# External network shared with the tunnel connector / reverse proxy.
CLOUDFLARE_TUNNEL_NETWORK=cloudflared
